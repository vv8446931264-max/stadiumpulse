# StadiumPulse needs a Gemini backend. Pick ONE:

# Option A — Vertex AI (no API key; uses GCP Application Default Credentials).
# This is how the deployed Cloud Run service authenticates.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Option B — Gemini Developer API (simplest for local dev).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
